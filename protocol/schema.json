{
  "contract": "LocalIM @ LAN 协议契约（唯一事实源）",
  "version": "1",
  "note": "本文件定义 WebUI <-> LocalIM 守护进程之间的控制/信令信封、命名空间、方法事件与载荷。媒体(P2P)与文件载荷走 WebRTC data channel，本文件只定义它们的信令与元数据。dev/daemon 的 node 实现、native/core 的 C++ 实现、ui/src 前端均按本契约实现。",

  "endpoints": {
    "ws_control":   { "proto": "ws",       "host": "127.0.0.1", "port": 7615, "desc": "桌面端 WebUI <-> 本机守护进程 控制/信令 WebSocket" },
    "udp_presence": { "proto": "udp",      "group": "239.255.0.16", "port": 7616, "desc": "同网段设备存在性多播(mDNS 化附加能力)" },
    "tcp_peer":     { "proto": "tcp",      "port": 7617, "desc": "P2P 直连/中转的消息与文件会话监听口" },
    "relay":        { "proto": "ws",       "port": 7618, "desc": "跨网段引导中继(网关注册 + 路由表同步)" }
  },

  "message": {
    "dir": ["req", "res", "ev"],
    "fields": {
      "v":   "整数 协议主版本=1",
      "txn": "字符串 事务ID(req/res 配对用, ev 可为空)",
      "dir": "req|res|ev",
      "ns":  "命名空间标识",
      "m":   "req/ev 的方法或事件名; req 为 method, ev 为 event 名",
      "ok":  "res 成功标识(布尔)",
      "err": "res 失败: {code:number, msg:string}",
      "d":   "载荷对象; res 失败时为 err 描述"
    },
    "example_req":  { "v": 1, "txn": "t-1", "dir": "req", "ns": "message", "m": "send", "d": { "to": "node-2", "type": "text", "kind": "chat", "body": "hello" } },
    "example_res":  { "v": 1, "txn": "t-1", "dir": "res", "ns": "message", "m": "send", "ok": true, "d": { "seq": 12 } },
    "example_ev":   { "v": 1, "dir": "ev", "ns": "presence", "m": "peer_online", "d": { "deviceId": "node-2", "name": "tax-2", "addr": "192.168.1.22" } }
  },

  "identity": {
    "req": ["hello", "set_profile"],
    "ev":  [],
    "hello_d": {
      "deviceId": "持久化设备ID(uuid)",
      "name": "本机用户名",
      "platform": "win|mac|linux",
      "version": "本地LocalIM版本"
    },
    "set_profile_d": { "name": "可选新用户名" }
  },

  "discovery": {
    "req": ["scan_start", "scan_stop"],
    "ev":  ["peer_found", "peer_lost", "segment_dirty"],
    "peer": {
      "deviceId": "设备ID",
      "name": "设备名/用户名",
      "host": "直连IP(同网段为局域网IP, 跨网段为中继可达地址)",
      "netmask": "所属网段",
      "via": "lan|relay",
      "lastSeen": "毫秒时间戳",
      "caps": ["chat","media","file","remote","share"]
    },
    "scan_start_d": { "requireCross": "是否启用中继扫描(默认true)" },
    "peer_found_d": "peer 对象",
    "peer_lost_d": { "deviceId": "设备ID" }
  },

  "roster": {
    "req": ["list"],
    "ev":  ["peer_ready"],
    "list_d": { "peers": "数组[discovery.peer]" }
  },

  "message": {
    "req": ["send", "history"],
    "ev":  ["chat"],
    "types": {
      "text": "纯文本", "image": "图片", "audio": "语音(短)", "video": "视频文件", "file": "任意文件",
      "emoji": "表情", "system": "系统/提示"
    },
    "kinds": { "chat": "单聊", "room": "群聊" },
    "message_payload": {
      "kind": "chat|room",
      "type": "上列 types",
      "from": "发送方 deviceId",
      "to": "单聊=对方deviceId; 群聊=roomId",
      "nonce": "客户端生成去重ID",
      "ts": "毫秒时间戳",
      "body": "type=text 为文本内容; 其它为 mediaRef",
      "mediaRef": "可选 {name,size,mime,chunk,sha256,url,thumbUrl}",
      "replyTo": "可选 引用的消息ID"
    },
    "send_d": { "seq": "服务器/守护进程分配序号", "accepted": true },
    "history_d": { "items": "数组[message_payload](旧->新)", "cursor": "分页游标(暂为空, 一次性返回最近 limit 条)" },
    "history_req_d": { "to": "单聊=对方deviceId; 群聊=roomId", "kind": "chat|room", "limit": "可选 返回条数上限(默认200)" },
    "chat_ev_d": "message_payload",
    "route_note": "同网段经 tcp_peer 直投; 跨网段经 relay 中继; 群聊由群主(房主)转发广播(无中心时 mesh 同步)"
  },

  "room": {
    "req": ["create", "join", "leave", "invite", "kick", "members", "exit"],
    "ev":  ["joined", "left", "invited", "member_joined", "member_left", "room_message", "room_sync"],
    "field": {
      "roomId": "群ID", "name": "群名", "owner": "房主deviceId",
      "members": "数组[deviceId]", "seq": "单调序列", "meshPort": "房主 tcp_peer 口"
    },
    "note": "群为以房主为根的 mesh: 成员向房主订阅, 房主做拓扑广播; 房主离线时由次级成员接替(占位, roadmap)"
  },

  "media": {
    "req": ["call_invite", "call_accept", "call_reject", "call_hangup", "offer", "answer", "ice", "share_start", "share_stop", "remote_start", "remote_stop", "remote_input"],
    "ev":  ["call", "media"],
    "sdp": { "sdp": "SDP文本", "type": "offer|answer" },
    "ice": { "candidate": "ICE候选人", "sdpMLineIndex": 0, "sdpMid": "" },
    "call": {
      "callId": "媒体会话ID", "from": "deviceId", "to": "deviceId|roomId",
      "mode": "voice|video|share(共享桌面)|remote(远程控制)",
      "direction": "incoming|outgoing|member"
    },
    "input_type": "mousemove|mousedown|mouseup|wheel|keydown|keyup",
    "remote_input_d": { "t": "input_type", "x": "可选 坐标", "y": "可选 坐标", "btn": "可选 键位", "code": "可选 键盘码", "d": "可选 增量(滚轮)" },
    "note": "信令经 daemon 中继; 音视频与桌面/远程画面走 P2P RTCPeerConnection; 远程输入走 data channel 回传到被控端 native input_injector"
  },

  "file": {
    "req": ["transfer_begin", "transfer_ack", "transfer_cancel"],
    "ev":  ["transfer_status"],
    "metadata": { "fileId": "会话内文件ID", "to": "deviceId|roomId", "name": "文件名", "size": "字节", "mime": "MIME", "sha256": "可选 校验" },
    "chunk_header": { "fileId": "文件ID", "chunkIndex": "分片序号", "total": "总分片数", "offset": "字节偏移", "len": "本分片字节数" },
    "note": "metadata+chunk_header 走信令/控制面, 二进制分片走 data channel(单聊直连, 群聊房主转发); 大文件断点续传在 roadmap"
  },

  "profile": {
    "req": ["get", "update"],
    "d": { "deviceId": "设备ID", "name": "用户名", "avatar": "头像URL或dataURI", "joinedRooms": "数组[roomId]" }
  }
}